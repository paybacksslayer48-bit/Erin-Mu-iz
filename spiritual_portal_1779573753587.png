export type ThemeType = 'night' | 'day';

export interface QuizState {
  problem: string;
  readiness: string;
}

export interface TestimonialItem {
  id: string;
  name: string;
  age?: number;
  before: string;
  after: string;
  avatarUrl: string;
}

export interface OfferCard {
  id: string;
  title: string;
  tag: string;
  description: string;
  benefits: string[];
  ctaText: string;
  link?: string;
  isInteractiveQuiz: boolean;
  intensity: 'soft' | 'deep' | 'high';
}
